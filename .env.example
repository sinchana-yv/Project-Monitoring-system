# Flask session signing key. Generate a long random value for local/prod use.
NIRIKSHAN_SECRET_KEY=replace-with-a-long-random-secret

# Set to 1 only when serving the app over HTTPS.
NIRIKSHAN_COOKIE_SECURE=0

# Frontend URL embedded in password reset links.
NIRIKSHAN_FRONTEND_URL=http://127.0.0.1:5173

# SMTP settings required for real password-reset email delivery.
NIRIKSHAN_SMTP_HOST=smtp.example.com
NIRIKSHAN_SMTP_PORT=587
NIRIKSHAN_SMTP_USERNAME=your-smtp-username
NIRIKSHAN_SMTP_PASSWORD=your-smtp-password
NIRIKSHAN_SMTP_FROM=your-sender@example.com
