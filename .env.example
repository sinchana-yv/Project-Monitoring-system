# Flask session signing key. Generate a long random value for local/prod use.
AVLOKAN_SECRET_KEY=replace-with-a-long-random-secret

# Set to 1 only when serving the app over HTTPS.
AVLOKAN_COOKIE_SECURE=0

# Frontend URL embedded in password reset links.
AVLOKAN_FRONTEND_URL=http://127.0.0.1:5173

# SMTP settings required for real password-reset email delivery.
AVLOKAN_SMTP_HOST=smtp.example.com
AVLOKAN_SMTP_PORT=587
AVLOKAN_SMTP_USERNAME=your-smtp-username
AVLOKAN_SMTP_PASSWORD=your-smtp-password
AVLOKAN_SMTP_FROM=your-sender@example.com
